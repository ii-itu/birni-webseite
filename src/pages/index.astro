---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import ContactCta from '@/components/ContactCta.astro';
import { focusAreas, practice } from '@/data/site';
import portrait from '@/assets/birnstein-10.jpg';

const steps = [
  {
    icon: 'chat',
    title: 'Erstgespräch',
    text: 'Wir lernen uns kennen und klären Ihr Anliegen. Danach entscheiden Sie in Ruhe, ob Sie eine Psychotherapie bei mir beginnen möchten.',
  },
  {
    icon: 'leaf',
    title: 'Psychotherapie',
    text: 'In Einzelsitzungen zu je 50 Minuten arbeiten wir an Ihren Themen – in einem geschützten, vertraulichen Rahmen.',
  },
  {
    icon: 'euro',
    title: 'Kassenzuschuss',
    text: 'Bei einer krankheitswertigen Störung können Sie bei Ihrer Krankenkasse einen Teil der Kosten zurückerhalten.',
  },
] as const;
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="eyebrow">{practice.tagline} in {practice.city}</p>
        <h1>Raum für Veränderung. <em>Schritt für Schritt.</em></h1>
        <p class="lead">
          Ich begleite Sie mit {practice.method} dabei, belastende Erfahrungen zu verstehen, neue Wege des Denkens,
          Erlebens und Handelns zu finden und wieder mehr Halt im eigenen Leben zu spüren.
        </p>
        <div class="btn-row">
          <a class="btn" href={practice.phoneHref}>
            <Icon name="phone" />
            Termin vereinbaren
          </a>
          <a class="btn btn--ghost" href="/rahmenbedingungen/">
            Ablauf & Kosten
            <Icon name="arrow" />
          </a>
        </div>
        <ul class="hero-facts">
          <li><Icon name="check" size={18} /> Unverbindliches Erstgespräch</li>
          <li><Icon name="check" size={18} /> Kassenzuschuss möglich</li>
          <li><Icon name="check" size={18} /> Gesetzliche Verschwiegenheitspflicht</li>
        </ul>
      </div>

      <div class="hero-visual">
        <div class="portrait">
          <Image
            src={portrait}
            alt={`Porträt von ${practice.name}`}
            widths={[250]}
            sizes="250px"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="hero-badge">
          <span class="icon-badge"><Icon name="heart" /></span>
          <span>
            <strong>{practice.name}</strong>
            <span>Psychotherapeut · {practice.method}</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Psychotherapie -->
  <section class="section" id="psychotherapie">
    <div class="container about-grid">
      <div class="section-head reveal">
        <p class="eyebrow">Psychotherapie</p>
        <h2>Integrative Therapie – mehr als nur Reden</h2>
        <p class="lead">
          Ein therapeutisches Verfahren, bei dem neben dem verbalen Austausch auch kreative Methoden, Techniken und Medien
          eingesetzt werden können.
        </p>
      </div>
      <div class="about-text reveal">
        <p>
          Das Ziel ist, Heilungsprozesse bei psychischen, psychosomatischen und psychosozialen Erkrankungen in Gang zu
          setzen, Besserungen von seelischen Leidenszuständen zu erwirken sowie die Beseitigung von Krankheitssymptomen
          zu erreichen.
        </p>
        <p>
          Im therapeutischen Prozess setzen wir uns mit Ihren aktuellen Lebensproblemen, Ihrem sozialen Umfeld sowie mit
          Ihren unbewussten Konflikten auseinander. Im Zuge dessen werden negative und defizitäre, aber auch positive und
          stützende Ereignisse erfahrbar gemacht und deren Auswirkungen auf Ihre Persönlichkeit und Ihre Lebensführung in
          den Blick genommen.
        </p>
        <blockquote>
          Ich unterstütze Sie dabei, neue Möglichkeiten des Denkens, Erlebens und Verhaltens zu finden – für eine
          nachhaltige Veränderung Ihres Lebensstils.
        </blockquote>
      </div>
    </div>
  </section>

  <!-- Schwerpunkte -->
  <section class="section section--tint" id="schwerpunkte">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <p class="eyebrow">Arbeitsschwerpunkte</p>
        <h2>Wobei ich Sie begleiten kann</h2>
        <p class="lead">
          Im Zuge meiner psychotherapeutischen Tätigkeit konnte ich mir vor allem in diesen Bereichen umfangreiches
          Wissen aneignen und Erfahrungen sammeln.
        </p>
      </div>
      <ul class="focus-grid">
        {
          focusAreas.map((f) => (
            <li class="card focus-card reveal">
              <span class="icon-badge">
                <Icon name={f.icon} />
              </span>
              <h3>{f.title}</h3>
              {f.text && <p>{f.text}</p>}
            </li>
          ))
        }
        <li class="focus-card focus-card--more reveal">
          <h3>Ihr Thema ist nicht dabei?</h3>
          <p>Sprechen Sie mich gerne an – im Erstgespräch klären wir gemeinsam, ob ich der richtige Ansprechpartner bin.</p>
          <a href="/kontakt/">Kontakt aufnehmen <Icon name="arrow" size={18} /></a>
        </li>
      </ul>
    </div>
  </section>

  <!-- Ablauf -->
  <section class="section" id="ablauf">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">So läuft es ab</p>
        <h2>In drei Schritten zur Therapie</h2>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step reveal">
              <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="icon-badge">
                <Icon name={s.icon} />
              </span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="steps-more reveal">
        <a class="btn btn--ghost" href="/rahmenbedingungen/">
          Alle Details zu Ablauf, Kosten & Zuschüssen
          <Icon name="arrow" />
        </a>
      </p>
    </div>
  </section>

  <ContactCta />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 8vw, 6.5rem);
    background:
      radial-gradient(55% 90% at 85% 30%, var(--blue-100) 0%, transparent 70%),
      linear-gradient(180deg, var(--blue-50) 0%, #fff 100%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
  }
  .hero h1 em {
    font-style: italic;
    color: var(--blue);
  }
  .hero .lead {
    max-width: 54ch;
    margin-bottom: 2rem;
  }
  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
  .hero-facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hero-facts :global(.icon) {
    color: var(--blue);
  }

  .hero-visual {
    position: relative;
    justify-self: center;
    width: min(100%, 330px);
  }
  .hero-visual::before {
    /* versetzte blaue Fläche – Anlehnung an die alte Seite */
    content: '';
    position: absolute;
    inset: -18px -18px 18px 18px;
    border-radius: 40% 40% var(--radius-lg) var(--radius-lg) / 30% 30% var(--radius-lg) var(--radius-lg);
    background: var(--blue-200);
  }
  .portrait {
    position: relative;
    border-radius: 40% 40% var(--radius-lg) var(--radius-lg) / 30% 30% var(--radius-lg) var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
    background: var(--blue-100);
    aspect-ratio: 2 / 3;
  }
  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-badge {
    position: absolute;
    left: -2.5rem;
    bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 1.1rem 0.8rem 0.8rem;
    background: #fff;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    font-size: 0.85rem;
    line-height: 1.35;
  }
  .hero-badge strong {
    display: block;
    font-size: 0.95rem;
  }
  .hero-badge span span {
    color: var(--ink-soft);
  }

  /* Psychotherapie */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .about-grid .section-head {
    margin-bottom: 0;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }
  blockquote {
    margin: 2rem 0 0;
    padding: 1.5rem 1.75rem;
    border-left: 3px solid var(--blue);
    background: var(--blue-50);
    border-radius: 0 var(--radius) var(--radius) 0;
    font: italic 400 1.25rem/1.5 var(--font-serif);
    color: var(--ink);
  }

  /* Schwerpunkte */
  .focus-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .focus-card {
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
  }
  .focus-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: var(--blue-200);
  }
  .focus-card h3 {
    margin: 1.1rem 0 0.4rem;
  }
  .focus-card p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.975rem;
  }
  .focus-card--more {
    border-radius: var(--radius);
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--blue-100);
    border: 1px dashed var(--blue);
  }
  .focus-card--more h3 {
    margin-top: 0;
  }
  .focus-card--more p {
    margin-bottom: 1rem;
  }
  .focus-card--more a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    text-decoration: none;
  }

  /* Ablauf */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: step;
  }
  .step {
    position: relative;
    padding: 2rem;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .step-num {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    font: 500 2.5rem/1 var(--font-serif);
    color: var(--blue-200);
  }
  .step h3 {
    margin: 1.1rem 0 0.4rem;
  }
  .step p {
    margin: 0;
    color: var(--ink-soft);
  }
  .steps-more {
    margin: 2rem 0 0;
  }

  @media (max-width: 900px) {
    .hero-grid,
    .about-grid {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      order: -1;
      width: min(80%, 280px);
      margin-top: 1rem;
    }
    .hero-badge {
      left: -1rem;
      bottom: 1rem;
    }
    .about-grid .section-head {
      position: static;
    }
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
