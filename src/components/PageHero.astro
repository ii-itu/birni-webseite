---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(2.5rem, 6vw, 4rem);
    background:
      radial-gradient(60% 120% at 100% 0%, var(--blue-100) 0%, transparent 60%),
      linear-gradient(180deg, var(--blue-50), #fff);
  }
  .page-hero::after {
    content: '';
    position: absolute;
    right: -120px;
    top: -120px;
    width: 360px;
    height: 360px;
    border-radius: 50%;
    border: 1px solid var(--blue-200);
    pointer-events: none;
  }
  h1 {
    max-width: 18ch;
  }
  .lead {
    max-width: 60ch;
    margin: 0;
  }
</style>
