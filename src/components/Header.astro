---
import Icon from './Icon.astro';
import { nav, practice } from '@/data/site';

const current = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${practice.name} – Startseite`}>
      <span class="brand-mark" aria-hidden="true">MB</span>
      <span class="brand-text">
        <span class="brand-name">{practice.name}</span>
        <span class="brand-sub">{practice.tagline}</span>
      </span>
    </a>

    <nav class="main-nav" id="main-nav" aria-label="Hauptnavigation">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn nav-cta" href={practice.phoneHref}>
        <Icon name="phone" />
        <span>{practice.phoneDisplay}</span>
      </a>
    </nav>

    <button class="nav-toggle" type="button" aria-controls="main-nav" aria-expanded="false" data-nav-toggle>
      <span class="visually-hidden">Menü öffnen</span>
      <Icon name="menu" class="i-open" />
      <Icon name="close" class="i-close" />
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');

  const setOpen = (open: boolean) => {
    if (!header || !toggle) return;
    header.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };

  toggle?.addEventListener('click', () => setOpen(!header?.classList.contains('is-open')));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  window.matchMedia('(min-width: 900px)').addEventListener('change', () => setOpen(false));

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* hellblauer Header mit kräftiger blauer Linie – wie auf der alten Seite */
    background: var(--blue-100);
    border-bottom: 5px solid var(--blue);
    transition: box-shadow 0.3s;
  }
  .site-header.is-scrolled {
    box-shadow: 0 8px 24px -16px rgb(16 42 66 / 0.35);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: var(--header-h);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    color: var(--ink);
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 13px;
    background: var(--blue);
    color: #fff;
    font: 600 1.05rem/1 var(--font-serif);
    letter-spacing: 0.02em;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .brand-name {
    font: 600 1.1rem/1.2 var(--font-serif);
  }
  .brand-sub {
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }
  .main-nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .main-nav ul a {
    display: block;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    color: var(--blue-700);
    font-weight: 700;
    font-size: 0.975rem;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .main-nav ul a:hover {
    background: rgb(255 255 255 / 0.6);
    color: var(--blue-800);
  }
  .main-nav ul a[aria-current='page'] {
    background: #fff;
    color: var(--blue-800);
  }
  .nav-cta {
    padding: 0.65rem 1.15rem;
    min-height: 44px;
    font-size: 0.95rem;
  }

  .nav-toggle {
    display: none;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink);
    cursor: pointer;
  }
  .nav-toggle :global(.i-close) {
    display: none;
  }

  @media (max-width: 899px) {
    .nav-toggle {
      display: grid;
    }
    .main-nav {
      position: fixed;
      inset: calc(var(--header-h) + 5px) 0 0;
      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
      padding: 1.5rem var(--gutter) 2rem;
      background: #fff;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity 0.25s, transform 0.25s, visibility 0.25s;
      overflow-y: auto;
    }
    .main-nav ul {
      flex-direction: column;
      gap: 0.25rem;
    }
    .main-nav ul a[aria-current='page'] {
      background: var(--blue-100);
    }
    .main-nav ul a {
      font-family: var(--font-serif);
      font-weight: 600;
      font-size: 1.5rem;
      padding: 0.75rem 1rem;
      border-radius: var(--radius-sm);
    }
    .nav-cta {
      min-height: 52px;
      font-size: 1.05rem;
    }
    .is-open .main-nav {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .is-open .nav-toggle :global(.i-open) {
      display: none;
    }
    .is-open .nav-toggle :global(.i-close) {
      display: block;
    }
  }

  @media (max-width: 420px) {
    .brand-sub {
      display: none;
    }
  }
</style>
